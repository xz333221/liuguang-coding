# coding.flowdash.cn 反向代理示例
#
# 要点只有一个:问答接口是 SSE,必须关掉代理缓冲,否则回答会攒到最后一次性吐出来。

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name coding.flowdash.cn;

    # 证书沿用现有那套即可
    ssl_certificate     /etc/letsencrypt/live/flowdash.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/flowdash.cn/privkey.pem;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE:不缓冲、不缓存、超时给足
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        chunked_transfer_encoding on;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name coding.flowdash.cn;
    return 301 https://$host$request_uri;
}
