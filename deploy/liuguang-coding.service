# 【留档】旧 Linux 机器的 systemd 单元。2026-11 起线上换到 Windows 机器(nginx 反代 + node 读 dist),
# 发布用 scripts/deploy-on-windows.ps1;这个文件只在将来重建 Linux 环境时参考。

[Unit]
Description=liuguang-coding 知识库(站点 + 问答接口)
Documentation=https://github.com/xz333221/liuguang-coding
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 按服务器实际情况改成拥有该目录的用户
User=www-data
Group=www-data
WorkingDirectory=/opt/liuguang-coding
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=DATA_DIR=/opt/liuguang-coding/server/data
# 模型密钥、数据库连接(DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME)这类东西写在这里,别进仓库
EnvironmentFile=-/opt/liuguang-coding/.env.server
ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=3
# 只监听本机,外网由 nginx 进来
Environment=HOST=127.0.0.1

[Install]
WantedBy=multi-user.target
