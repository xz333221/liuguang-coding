---
// 讲解:DDD 的四层与依赖方向。
// 点一层,看它该放什么、不该放什么、允许依赖谁,以及这一层的一段真实代码(来自 examples/ddd-demo)。
// 代码先走 Shiki 渲染好,切层只是显示/隐藏。
import { highlight } from '../lib/highlight'

interface Layer {
  id: string
  name: string
  /** 目录名,和示例工程一致 */
  path: string
  what: string
  avoid: string
  /** 依赖方向:谁可以调它、它可以调谁 */
  deps: string
  code: string
  lang: string
}

const layers: Layer[] = [
  {
    id: 'interfaces',
    name: '接口层',
    path: 'interfaces/',
    what: '接收外部请求并翻译成命令:路由、参数绑定、鉴权入口。示例里用命令行代替 HTTP,换成 Controller 时业务一行不用搬。',
    avoid: '业务判断、直接调仓储、把实体直接返回给前端。',
    deps: '可以调 application;不知道 infrastructure 的存在。',
    lang: 'java',
    code: `OrderRepository orders =
        new InMemoryOrderRepository();
DomainEventPublisher publisher =
        new ConsoleEventPublisher();
OrderApplicationService service =
        new OrderApplicationService(orders, publisher);

OrderId id = service.place(command);`,
  },
  {
    id: 'application',
    name: '应用层',
    path: 'application/',
    what: '一个方法一个用例:建聚合、调行为、存、发事件。事务边界和权限校验也在这层。',
    avoid: '领域规则(空订单能不能提交、最多几行)—— 那是聚合根的活。',
    deps: '可以调 domain;不依赖具体的仓储实现。',
    lang: 'java',
    code: `public OrderId place(PlaceOrderCommand command) {
    Order order = Order.draft(
            OrderId.newId(), command.customerId());
    command.lines().forEach(order::addLine);

    order.place();          // 规则在聚合根里
    orders.save(order);
    publishEventsOf(order);

    return order.id();
}`,
  },
  {
    id: 'domain',
    name: '领域层',
    path: 'domain/',
    what: '业务语言本身:实体、值对象、聚合根、领域服务,以及仓储与事件发布接口。不引框架,所以能单独编译、单独测试。',
    avoid: 'Spring 注解、SQL、HTTP 对象、JSON 序列化。',
    deps: '谁都不依赖 —— 它是被依赖的那一端。',
    lang: 'java',
    code: `public void place() {
    requireStatus(DRAFT, "订单已提交或已取消");
    if (lines.isEmpty()) {
        throw new IllegalStateException("空订单不能提交");
    }
    status = PLACED;
    pendingEvents.add(new OrderPlaced(id, ...));
}`,
  },
  {
    id: 'infrastructure',
    name: '基础设施层',
    path: 'infrastructure/',
    what: '实现领域层声明的接口:仓储、事件发布、外部系统适配。换数据库、换消息队列只改这一层。',
    avoid: '业务规则;也不该被上层直接依赖(要依赖就依赖它的接口)。',
    deps: '依赖 domain(实现它的接口);不被 application 直接引用。',
    lang: 'java',
    code: `public class InMemoryOrderRepository
        implements OrderRepository {

    private final Map<OrderId, Order> store =
            new HashMap<>();

    @Override
    public void save(Order order) {
        store.put(order.id(), order);
    }
}`,
  },
]

const first = layers[0]
const data = JSON.stringify(layers)

const codeHtml = await Promise.all(layers.map((layer) => highlight(layer.code, layer.lang)))
---

<div class="ddd-demo" data-demo="ddd-layers" data-layers={data} data-index="0">
  <p class="ddd-hint">点一层,看它该放什么、不该放什么、允许依赖谁,以及这一层的一段真实代码。</p>

  <div class="ddd-strip">
    <span class="ddd-node">interfaces</span>
    <span class="ddd-arrow">→</span>
    <span class="ddd-node">application</span>
    <span class="ddd-arrow">→</span>
    <span class="ddd-node ddd-node-core">domain</span>
    <span class="ddd-arrow">←</span>
    <span class="ddd-node">infrastructure</span>
  </div>
  <p class="ddd-strip-note">箭头是"可以调到"。domain 谁也不依赖,infrastructure 反过来实现它 —— 方向是倒过来的。</p>

  <div class="ddd-tabs">
    {
      layers.map((layer, index) => (
        <button type="button" class="ddd-tab" data-layer={index} data-active={String(index === 0)}>
          <span class="ddd-tab-name">{layer.name}</span>
        </button>
      ))
    }
  </div>

  <section class="ddd-panel" aria-live="polite">
    <div class="ddd-head">
      <span class="ddd-title" data-title>{first.name}</span>
      <span class="ddd-path" data-path>{first.path}</span>
    </div>

    <dl class="ddd-rows">
      <dt>放什么</dt>
      <dd data-what>{first.what}</dd>
      <dt>不该放</dt>
      <dd class="ddd-avoid" data-avoid>{first.avoid}</dd>
      <dt>依赖</dt>
      <dd data-deps>{first.deps}</dd>
    </dl>

    {
      codeHtml.map((html, index) => (
        <div class="ddd-code" data-code-panel={index} data-active={String(index === 0)} set:html={html} />
      ))
    }
  </section>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-demo="ddd-layers"]')

  if (root) {
    interface Layer {
      id: string
      name: string
      path: string
      what: string
      avoid: string
      deps: string
      code: string
      lang: string
    }

    const layers = JSON.parse(root.dataset.layers ?? '[]') as Layer[]
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-layer]'))
    const title = root.querySelector<HTMLElement>('[data-title]')
    const path = root.querySelector<HTMLElement>('[data-path]')
    const what = root.querySelector<HTMLElement>('[data-what]')
    const avoid = root.querySelector<HTMLElement>('[data-avoid]')
    const deps = root.querySelector<HTMLElement>('[data-deps]')
    const codePanels = Array.from(root.querySelectorAll<HTMLElement>('[data-code-panel]'))

    const render = (index: number) => {
      const layer = layers[index]
      if (!layer) return

      tabs.forEach((tab, i) => {
        tab.dataset.active = String(i === index)
      })

      if (title) title.textContent = layer.name
      if (path) path.textContent = layer.path
      if (what) what.textContent = layer.what
      if (avoid) avoid.textContent = layer.avoid
      if (deps) deps.textContent = layer.deps
      codePanels.forEach((panel) => {
        panel.dataset.active = String(panel.dataset.codePanel === String(index))
      })
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => render(Number(tab.dataset.layer ?? 0)))
    })

    render(0)
  }
</script>

<style>
  /* 没有圆角、没有整圈描边:靠背景与细线分区 */
  .ddd-hint {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .ddd-strip {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: nowrap;
    overflow-x: auto;
    margin-top: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .ddd-node {
    flex: none;
    padding: 0.12rem 0.45rem;
    background: var(--panel);
    color: var(--muted);
  }

  .ddd-node-core {
    background: var(--accent);
    color: var(--on-accent);
  }

  .ddd-arrow {
    flex: none;
    color: var(--muted);
  }

  .ddd-strip-note {
    margin-top: 0.55rem;
    color: var(--muted);
    font-size: 0.72rem;
    line-height: 1.7;
  }

  .ddd-tabs {
    display: grid;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }

  @media (min-width: 720px) {
    .ddd-tabs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .ddd-tab {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 0.65rem;
    border-left: 2px solid transparent;
    background: var(--panel);
    color: var(--muted);
    font-size: 0.82rem;
    transition: color 0.18s, border-color 0.18s, background-color 0.18s;
  }

  .ddd-tab:hover {
    color: var(--ink);
  }

  .ddd-tab[data-active='true'] {
    border-left-color: var(--accent);
    background: var(--accent-soft);
    color: var(--ink);
  }

  .ddd-tab-name {
    font-size: 0.82rem;
  }

  .ddd-panel {
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .ddd-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .ddd-title {
    font-size: 0.9rem;
  }

  .ddd-path {
    font-family: var(--font-mono);
    color: var(--highlight);
    font-size: 0.72rem;
  }

  .ddd-rows {
    display: grid;
    gap: 0.55rem 1.2rem;
    margin-top: 0.9rem;
    grid-template-columns: 4rem minmax(0, 1fr);
  }

  .ddd-rows dt {
    padding-top: 0.15rem;
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .ddd-rows dd {
    font-size: 0.82rem;
    line-height: 1.8;
  }

  .ddd-avoid {
    color: color-mix(in srgb, var(--wrong) 70%, var(--muted));
  }

  .ddd-code {
    overflow-x: auto;
    margin-top: 1rem;
    padding: 0.8rem 0.9rem;
    background: var(--panel);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.8;
    white-space: pre;
  }

  @media (max-width: 640px) {
    .ddd-rows {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem 1rem;
    }

    .ddd-rows dt {
      margin-top: 0.45rem;
    }

    .ddd-code {
      font-size: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ddd-tab {
      transition: none;
    }
  }
</style>
