---
// 讲解:Spring Boot 项目的目录结构。
// 左边是一棵树,点哪一项,右边就说清这块该放什么、不该放什么,并把对应文件的代码摆出来。
// 数据全部在首屏渲染进 DOM(靠 data-items),交互时只换右侧内容,不发请求。
// 每个节点的代码先走 Shiki 渲染好,切换只是显示/隐藏。
import { highlight } from '../lib/highlight'

interface Node {
  label: string
  /** 嵌套层级,0 是 project 下的第一层 */
  depth: number
  kind: 'dir' | 'file'
  /** 这个目录/文件负责什么 */
  role: string
  /** 什么不该往里放 —— 判断归错位时最常见的失误 */
  avoid: string
  /** 代码片段,目录层级则留空 */
  code?: string
  lang?: string
}

const nodes: Node[] = [
  {
    label: 'pom.xml',
    depth: 0,
    kind: 'file',
    role: '工程描述:Maven 靠它知道 groupId、Java 版本、依赖、打包插件。父工程 spring-boot-starter-parent 统一管版本,所以下面的 starter 都不用写版本号。',
    avoid: '业务配置(端口、数据源)不写在这里,那是 application.yml 的事;依赖版本也别写死,让父工程管。',
    lang: 'xml',
    code: `<parent>
  <groupId>org.springframework.boot</groupId>
  <artifactId>spring-boot-starter-parent</artifactId>
  <version>3.3.5</version>
</parent>

<dependency>
  <groupId>org.springframework.boot</groupId>
  <artifactId>spring-boot-starter-web</artifactId>
</dependency>`,
  },
  {
    label: 'src/main/java/',
    depth: 0,
    kind: 'dir',
    role: '全部生产代码。下面的包按职责切分,不按"实体/工具/公共"这种类型切。启动类必须停在这层的根部。',
    avoid: '测试代码不放这里,那是 src/test/java 的位置;配置文件的 yml 也不放这里。',
  },
  {
    label: 'DemoApplication.java',
    depth: 1,
    kind: 'file',
    role: '启动类,全项目唯一。@SpringBootApplication = 配置类 + 自动配置 + 组件扫描;组件扫描从本类所在包往下递归,所以它必须待在最外层的包。',
    avoid: '别在这里写业务逻辑,也别把它挪进 controller/ 之类的子包里 —— 挪进去同级或更外层的类就扫不到了。',
    lang: 'java',
    code: `@SpringBootApplication
public class DemoApplication {
    public static void main(String[] args) {
        SpringApplication.run(DemoApplication.class, args);
    }
}`,
  },
  {
    label: 'controller/',
    depth: 1,
    kind: 'dir',
    role: '接口层:路由、参数绑定、状态码、把 Service 的结果原样返回(Jackson 负责转 JSON)。',
    avoid: '不写 SQL、不写业务规则、不开事务。Controller 里出现 if 判断"这书能不能标读过",就是规则放错地方了。',
    lang: 'java',
    code: `@RestController
@RequestMapping("/api/books")
public class BookController {

    private final BookService service;

    public BookController(BookService service) {
        this.service = service;
    }

    @GetMapping("/{id}")
    public Book detail(@PathVariable Long id) {
        return service.findById(id);
    }
}`,
  },
  {
    label: 'service/',
    depth: 1,
    kind: 'dir',
    role: '业务层:规则、编排、事务边界都在这。它不知道 HTTP 的存在,所以定时任务、消息队列也能直接复用。',
    avoid: '别把 HttpServletRequest、状态码传进来;也别直接写 SQL —— 那要经过 Repository。',
    lang: 'java',
    code: `@Service
public class BookService {

    private final BookRepository books;
    private final Clock clock;

    public BookService(BookRepository books, Clock clock) {
        this.books = books;
        this.clock = clock;
    }

    @Transactional(readOnly = true)
    public Book findById(Long id) {
        return books.findById(id)
                .orElseThrow(() -> new BookNotFoundException(id));
    }
}`,
  },
  {
    label: 'repository/',
    depth: 1,
    kind: 'dir',
    role: '存取层。继承 JpaRepository 就有了 save / findById / findAll,不用实现类;要定制查询就按方法名写 findByReadTrue,或上 @Query。',
    avoid: '别在这里判断业务规则,也别把实体换成 DTO 返回给外部 —— 转换是 Controller 的事。',
    lang: 'java',
    code: `public interface BookRepository extends JpaRepository<Book, Long> {
    // 一个方法都不写也够用
}`,
  },
  {
    label: 'model/',
    depth: 1,
    kind: 'dir',
    role: '实体:和数据库表一一对应的字段形状。@Entity 声明它是实体,@Column 描述列名与长度。',
    avoid: '不装 JSON 格式、不装入参校验。实体里塞 @NotBlank 之类的入参规则,是拿数据库模型当接口模型使。',
    lang: 'java',
    code: `@Entity
@Table(name = "book")
public class Book {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @Column(nullable = false, length = 120)
    private String title;

    @Column(nullable = false, length = 80)
    private String author;
}`,
  },
  {
    label: 'dto/',
    depth: 1,
    kind: 'dir',
    role: '入参/出参的形状。只带该给外面的字段,@Valid 的校验注解也写在这里。示例里用 record,省掉 getter。',
    avoid: '别让 Controller 直接收实体:主键、创建时间这些服务端自己决定的值,暴露出去就等于允许调用方伪造。',
    lang: 'java',
    code: `public record BookRequest(
        @NotBlank(message = "书名不能为空")
        @Size(max = 120)
        String title,

        @NotBlank(message = "作者不能为空")
        @Size(max = 80)
        String author
) {
}`,
  },
  {
    label: 'config/',
    depth: 1,
    kind: 'dir',
    role: '配置类:用 @Bean 把"可以替换的基础设施"声明出来 —— 时钟、线程池、序列化器、拦截器。',
    avoid: '别在这里写业务逻辑。配置类只负责造对象,不负责用对象。',
    lang: 'java',
    code: `@Configuration
public class ClockConfig {

    @Bean
    public Clock clock() {
        return Clock.systemUTC();
    }
}`,
  },
  {
    label: 'exception/',
    depth: 1,
    kind: 'dir',
    role: '自定义异常 + @RestControllerAdvice 的全局处理:把业务异常翻译成 HTTP 响应(这里是 404 + ProblemDetail)。',
    avoid: '别在每个 Controller 里写 try-catch;也别让异常继承 ResponseStatusException 之外的 HTTP 概念。',
    lang: 'java',
    code: `@RestControllerAdvice
public class GlobalExceptionHandler {

    @ExceptionHandler(BookNotFoundException.class)
    public ProblemDetail onNotFound(BookNotFoundException ex) {
        ProblemDetail problem = ProblemDetail.forStatus(HttpStatus.NOT_FOUND);
        problem.setTitle("书不存在");
        problem.setDetail(ex.getMessage());
        return problem;
    }
}`,
  },
  {
    label: 'src/main/resources/',
    depth: 0,
    kind: 'dir',
    role: '一切"非代码但应用需要的东西":配置、SQL、模板、静态文件。这里的内容会被原样打进 jar 的 BOOT-INF/classes。',
    avoid: '别把 Java 代码放这儿;也别随手改名,application.yml、schema.sql 这些名字 Spring Boot 自己认。',
  },
  {
    label: 'application.yml',
    depth: 1,
    kind: 'file',
    role: '端口、数据源、日志级别。启动时被加载成 Environment,按 命令行 > 环境变量 > application-{profile}.yml > application.yml 的顺序覆盖。',
    avoid: '密钥别写进来。这文件会进仓库,密钥要走环境变量或配置中心。',
    lang: 'yaml',
    code: `server:
  port: 8080

spring:
  datasource:
    url: jdbc:h2:mem:demo
    driver-class-name: org.h2.Driver
  jpa:
    hibernate:
      ddl-auto: none
  sql:
    init:
      mode: always`,
  },
  {
    label: 'schema.sql',
    depth: 1,
    kind: 'file',
    role: '建表语句。表结构写成文件,改动在代码评审里看得见,生产上也敢人工核对。',
    avoid: '别指望 ddl-auto: update 自动改表 —— 它在生产上不可控,示例里直接关掉。',
    lang: 'sql',
    code: `CREATE TABLE book (
  id         BIGINT AUTO_INCREMENT PRIMARY KEY,
  title      VARCHAR(120) NOT NULL,
  author     VARCHAR(80)  NOT NULL,
  read_flag  BOOLEAN      NOT NULL,
  created_at TIMESTAMP    NOT NULL
);`,
  },
  {
    label: 'src/test/java/',
    depth: 0,
    kind: 'dir',
    role: '测试代码,包路径与主代码保持一致。mvn package 时不会打进 jar,只在 mvn test 时跑。',
    avoid: '别把测试脚本、临时 main 方法丢进 src/main —— 那会跟着发布出去。',
    lang: 'java',
    code: `@SpringBootTest
@AutoConfigureMockMvc
class BookControllerTest {

    @Autowired
    private MockMvc mvc;

    @Test
    void 查不到返回404() throws Exception {
        mvc.perform(get("/api/books/99999"))
                .andExpect(status().isNotFound());
    }
}`,
  },
  {
    label: 'target/',
    depth: 0,
    kind: 'dir',
    role: '构建产物:mvn 生成的 class、jar 与报告。package 之后 jar 里有 BOOT-INF/classes 与 BOOT-INF/lib,内嵌 Tomcat 也在里面。',
    avoid: '别提交进仓库。它每次编译都变,提上去只会得到一堆没有意义的二进制 diff。',
  },
]

const data = JSON.stringify(nodes)

const codeHtml = await Promise.all(
  nodes.map((node) => (node.code ? highlight(node.code, node.lang ?? 'java') : Promise.resolve(''))),
)
---

<div class="sb-demo" data-demo="springboot-tree" data-items={data}>
  <p class="sb-hint">
    点一项,看它负责什么、不该往里放什么,以及对应文件的代码。
  </p>

  <div class="sb-body">
    <nav class="sb-tree" aria-label="项目目录">
      <p class="sb-tree-title">springboot-demo/</p>
      <ul>
        {
          nodes.map((item, index) => (
            <li>
              <button
                type="button"
                class="sb-item"
                data-index={index}
                data-active={String(index === 0)}
                style={`--d:${item.depth}`}
              >
                <span class="sb-item-kind" data-kind={item.kind}>
                  {item.kind === 'dir' ? '目录' : '文件'}
                </span>
                <span class="sb-item-label">{item.label}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="sb-panel" aria-live="polite">
      <div class="sb-panel-head">
        <span class="sb-path" data-path>{nodes[0].label}</span>
        <span class="sb-tag" data-tag>{nodes[0].kind === 'dir' ? '目录' : '文件'}</span>
      </div>
      <p class="sb-label">负责什么</p>
      <p class="sb-role" data-role>{nodes[0].role}</p>
      <p class="sb-label">不该放什么</p>
      <p class="sb-avoid" data-avoid>{nodes[0].avoid}</p>
      <div class="sb-code-wrap" data-code-wrap>
        {
          codeHtml.map((html, index) => (
            <div
              class="sb-code"
              data-code-panel={index}
              data-active={String(index === 0)}
              set:html={html}
            />
          ))
        }
      </div>
    </section>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-demo="springboot-tree"]')

  if (root) {
    interface Node {
      label: string
      depth: number
      kind: 'dir' | 'file'
      role: string
      avoid: string
      code?: string
      lang?: string
    }

    const nodes = JSON.parse(root.dataset.items ?? '[]') as Node[]
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>('.sb-item'))
    const path = root.querySelector<HTMLElement>('[data-path]')
    const tag = root.querySelector<HTMLElement>('[data-tag]')
    const role = root.querySelector<HTMLElement>('[data-role]')
    const avoid = root.querySelector<HTMLElement>('[data-avoid]')
    const codeWrap = root.querySelector<HTMLElement>('[data-code-wrap]')
    const codePanels = Array.from(root.querySelectorAll<HTMLElement>('[data-code-panel]'))

    const render = (index: number) => {
      const node = nodes[index]
      if (!node) return

      items.forEach((item, i) => {
        item.dataset.active = String(i === index)
      })

      if (path) path.textContent = node.label
      if (tag) {
        tag.textContent = node.kind === 'dir' ? '目录' : '文件'
        tag.dataset.kind = node.kind
      }
      if (role) role.textContent = node.role
      if (avoid) avoid.textContent = node.avoid
      codePanels.forEach((panel) => {
        panel.dataset.active = String(panel.dataset.codePanel === String(index))
      })
      if (codeWrap) codeWrap.dataset.show = String(Boolean(node.code))
    }

    items.forEach((item) => {
      item.addEventListener('click', () => render(Number(item.dataset.index ?? 0)))
    })

    render(0)
  }
</script>

<style>
  /* 没有圆角、没有整圈描边:靠背景分区与细线分隔,免得整块像一张贴上去的卡片。 */
  .sb-hint {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.7;
  }

  .sb-body {
    display: grid;
    gap: 1.6rem;
    margin-top: 1rem;
  }

  .sb-tree {
    min-width: 0;
  }

  .sb-tree-title {
    padding-bottom: 0.6rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .sb-tree ul {
    display: grid;
    gap: 0.1rem;
    border-top: 1px solid var(--line);
    padding-top: 0.35rem;
  }

  .sb-item {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    width: 100%;
    padding: 0.3rem 0.5rem 0.3rem calc(0.5rem + var(--d) * 1.05rem);
    border-left: 2px solid transparent;
    color: var(--muted);
    font-size: 0.8rem;
    text-align: left;
    transition: color 0.18s, background-color 0.18s, border-color 0.18s;
  }

  .sb-item:hover {
    background: var(--panel);
    color: var(--ink);
  }

  .sb-item[data-active='true'] {
    border-left-color: var(--accent);
    background: var(--accent-soft);
    color: var(--ink);
  }

  .sb-item-kind {
    flex: none;
    color: var(--muted);
    font-size: 0.62rem;
    letter-spacing: 0.06rem;
  }

  .sb-item[data-active='true'] .sb-item-kind {
    color: var(--highlight);
  }

  .sb-item-label {
    font-family: var(--font-mono);
    word-break: break-all;
  }

  .sb-panel {
    min-width: 0;
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
  }

  .sb-panel-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .sb-path {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    word-break: break-all;
  }

  .sb-tag {
    padding: 0.08rem 0.45rem;
    background: var(--panel);
    color: var(--muted);
    font-size: 0.64rem;
  }

  .sb-tag[data-kind='file'] {
    background: var(--accent-soft);
    color: var(--highlight);
  }

  .sb-label {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.09em;
  }

  .sb-role,
  .sb-avoid {
    margin-top: 0.35rem;
    font-size: 0.82rem;
    line-height: 1.8;
  }

  .sb-avoid {
    color: color-mix(in srgb, var(--wrong) 70%, var(--muted));
  }

  .sb-code-wrap {
    margin-top: 1.1rem;
    background: var(--panel);
  }

  .sb-code-wrap[data-show='false'] {
    display: none;
  }

  .sb-code {
    display: none;
    overflow-x: auto;
    padding: 0.85rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.85;
  }

  .sb-code[data-active='true'] {
    display: block;
  }

  /* Shiki 生成完整 <pre>,边距底色交给外层 */
  .sb-code :global(pre) {
    margin: 0;
    padding: 0;
    background: transparent !important;
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    overflow: visible;
  }

  .sb-code :global(code) {
    font-family: inherit;
  }

  @media (max-width: 640px) {
    .sb-code {
      font-size: 0.7rem;
      padding: 0.75rem 0.8rem;
    }
  }

  .sb-code:empty {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sb-item {
      transition: none;
    }
  }
</style>
