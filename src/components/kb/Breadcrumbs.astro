---
import { pathOf } from '../../data/catalog'
import { categoryPath, withBase } from '../../lib/content'

interface Props {
  categoryId: string
  categoryName: string
  title?: string
}

const { categoryId, categoryName, title } = Astro.props
// 章节树有三层,面包屑要整条祖先链都带上(编程语言 / Java / 3 面向对象 / 3.2 比较规则)
const trail = pathOf(categoryId)
---

<nav aria-label="面包屑" class="mb-6 flex flex-wrap items-center gap-2 text-[0.78rem] text-muted">
  <a href={withBase()} class="hover:text-ink">知识库</a>
  {
    trail.map((node) => (
      <>
        <span aria-hidden="true" class="text-line-strong">/</span>
        <a href={categoryPath(node.id)} class="hover:text-ink">{node.name}</a>
      </>
    ))
  }
  <span aria-hidden="true" class="text-line-strong">/</span>
  <a href={categoryPath(categoryId)} class="hover:text-ink">{categoryName}</a>
  {
    title ? (
      <>
        <span aria-hidden="true" class="text-line-strong">/</span>
        <span class="text-ink">{title}</span>
      </>
    ) : null
  }
</nav>