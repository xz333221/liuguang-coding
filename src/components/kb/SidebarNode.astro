---
// 目录树的一个节点(方向 / 章 / 节 / 小节),递归渲染。
//
// 编号不在数据里,由父节点往下传:java 标了 numbered,它的 children 就是 1..17,
// 再往下拼成 3.1 / 3.1.1。空节点(子树里 0 篇文章)显示「筹备中」并压暗 ——
// 补上文章后自动恢复,不用回来改数据。
//
// 有子章节的节点多一个折叠开关:点名字进章节页,点箭头就地开合。
// 默认开合由这里算(编号章节收起、当前路径展开),浏览器再按 localStorage 覆盖。
import type { Category } from '../../data/catalog'
import type { Topic } from '../../lib/content'
import { categoryPath, countFor, topicNode, topicPath } from '../../lib/content'
import SidebarNode from './SidebarNode.astro'

interface Props {
  node: Category
  /** 全部文章(已按大纲排好序) */
  topics: Topic[]
  counts: Record<string, number>
  current?: string
  currentTopic?: string
  /** 展示编号,如 '3.1';方向级节点不传 */
  number?: string
  depth?: number
  /** 当前页面所在的祖先链(含自己),这些节点不受折叠记忆影响,始终展开 */
  openPath: Set<string>
  /** 同一页渲染两份侧栏(桌面 aside + 移动 details),DOM id 靠它区分 */
  scope: string
}

const {
  node,
  topics,
  counts,
  current,
  currentTopic,
  number,
  depth = 0,
  openPath,
  scope,
} = Astro.props
const count = countFor(node.id, counts)
const children = (node.children ?? []).filter((child) => child.status !== 'hidden')
const own = topics.filter((topic) => topicNode(topic) === node.id)
// 编号已经把层级说清了,缩进只做轻提示;240px 的侧栏再深就挤掉名字了
const indent = Math.min(depth, 4)
const collapsible = children.length > 0
const onPath = openPath.has(node.id)
// 方向层(没有编号)保持展开,17 章默认收起,不然侧栏一屏放不下
const open = !number || onPath
const panelId = `lg-nav-${scope}-${node.id}`
const toggleLabel = `${open ? '收起' : '展开'} ${number ? `${number} ` : ''}${node.name}`
---

<div class="lg-nav-branch" data-nav-node={node.id} data-nav-path={onPath} data-open={open}>
  <div class="lg-nav-row" style={`--nav-depth:${indent}`}>
    {
      collapsible ? (
        <button
          type="button"
          class="lg-nav-toggle"
          aria-expanded={open}
          aria-controls={panelId}
          aria-label={toggleLabel}
          title={open ? '收起' : '展开'}
        >
          <svg
            viewBox="0 0 16 16"
            width="10"
            height="10"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 4l4 4-4 4" />
          </svg>
        </button>
      ) : (
        <span class="lg-nav-toggle lg-nav-toggle--void" aria-hidden="true" />
      )
    }
    <a
      href={categoryPath(node.id)}
      class="lg-nav-item lg-nav-item--node"
      data-active={current === node.id}
      data-empty={count === 0}
      title={number ? `${number} ${node.name}` : node.name}
    >
      {number ? <span class="lg-nav-num">{number}</span> : null}
      <span class="min-w-0 flex-1 truncate">{node.name}</span>
      {count > 0 ? <span class="lg-nav-count">{count}</span> : <span class="lg-badge">筹备中</span>}
    </a>
  </div>

  {
    (collapsible || own.length > 0) && (
      <div class="lg-nav-panel" id={collapsible ? panelId : undefined} hidden={collapsible && !open}>
        {own.length > 0 && (
          <ul class="flex flex-col gap-0.5">
            {own.map((topic) => (
              <li>
                <a
                  href={topicPath(topic)}
                  class="lg-nav-item lg-nav-item--topic"
                  style={`--nav-depth:${Math.min(depth + 1, 4)}`}
                  data-active={currentTopic === topic.id}
                  title={topic.data.title}
                >
                  <span class="min-w-0 flex-1 truncate">{topic.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        )}
        {children.map((child, index) => (
          <SidebarNode
            node={child}
            topics={topics}
            counts={counts}
            current={current}
            currentTopic={currentTopic}
            number={node.numbered ? String(index + 1) : number ? `${number}.${index + 1}` : undefined}
            depth={depth + 1}
            openPath={openPath}
            scope={scope}
          />
        ))}
      </div>
    )
  }
</div>