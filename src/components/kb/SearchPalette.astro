---
// 站内搜索:页头一个入口 + 全站可用的命令面板(⌘K / Ctrl+K)。
// 索引是构建期生成的 /search-index.json,第一次打开面板时才拉。
---

<button type="button" class="lg-search-trigger" data-search-open aria-label="搜索知识库">
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none">
    <circle cx="7" cy="7" r="4.6" stroke="currentColor" stroke-width="1.6"></circle>
    <path d="M10.4 10.4 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
  <span>搜索</span>
  <kbd>⌘K</kbd>
</button>

<div class="lg-search" data-search hidden>
  <div class="lg-search-backdrop" data-search-close></div>

  <div class="lg-search-panel" role="dialog" aria-modal="true" aria-label="搜索知识库">
    <div class="lg-search-bar">
      <input
        type="search"
        data-search-input
        placeholder="搜知识点、小节标题、正文里的词…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="搜索关键词"
      />
      <kbd>Esc</kbd>
    </div>

    <p class="lg-search-meta" data-search-meta>输入关键词,↑↓ 选择,回车打开</p>

    <ul class="lg-search-list" data-search-list role="listbox" aria-label="搜索结果"></ul>
  </div>
</div>

<script>
  import { type SearchDoc, highlight, searchIndex } from '../../lib/search'

  const trigger = document.querySelector<HTMLButtonElement>('[data-search-open]')
  const root = document.querySelector<HTMLElement>('[data-search]')
  const input = root?.querySelector<HTMLInputElement>('[data-search-input]')
  const list = root?.querySelector<HTMLUListElement>('[data-search-list]')
  const meta = root?.querySelector<HTMLElement>('[data-search-meta]')

  if (root && input && list && meta) {
    // 面板必须挂在 body 下:页头有 backdrop-filter,会变成 position:fixed 的包含块,
    // 留在 header 里 inset:0 就相对 header 定位,面板会被拉宽、跑出屏幕。
    if (root.parentElement !== document.body) document.body.append(root)

    let docs: SearchDoc[] | null = null
    let loading: Promise<void> | null = null
    let hits: ReturnType<typeof searchIndex> = []
    let active = 0
    let lastQuery = ''

    const indexUrl = new URL(`${import.meta.env.BASE_URL}search-index.json`, window.location.origin).href

    const loadIndex = () => {
      if (docs) return Promise.resolve()
      if (!loading) {
        loading = fetch(indexUrl)
          .then((res) => res.json() as Promise<SearchDoc[]>)
          .then((data) => {
            docs = data
          })
          .catch(() => {
            loading = null
            meta.textContent = '索引没加载出来,刷新页面再试'
          })
      }
      return loading
    }

    const isOpen = () => !root.hidden

    const setActive = (next: number) => {
      const items = Array.from(list.querySelectorAll<HTMLElement>('[data-hit]'))
      if (items.length === 0) return
      active = (next + items.length) % items.length
      items.forEach((item, i) => {
        const on = i === active
        item.classList.toggle('is-active', on)
        item.setAttribute('aria-selected', on ? 'true' : 'false')
        if (on) item.scrollIntoView({ block: 'nearest' })
      })
      input.setAttribute('aria-activedescendant', items[active].id)
    }

    const render = (query: string) => {
      if (!docs) return
      const trimmed = query.trim()
      list.innerHTML = ''
      active = 0

      if (trimmed.length === 0) {
        hits = []
        meta.textContent = '输入关键词,↑↓ 选择,回车打开'
        return
      }

      hits = searchIndex(docs, trimmed, 24)
      meta.textContent = hits.length === 0 ? `没有匹配「${trimmed}」的条目` : `找到 ${hits.length} 条 · ↑↓ 选择,回车打开`

      for (const [i, hit] of hits.entries()) {
        const li = document.createElement('li')
        li.id = `lg-search-hit-${i}`
        li.className = 'lg-search-hit'
        li.dataset.hit = ''
        li.setAttribute('role', 'option')
        li.setAttribute('aria-selected', i === 0 ? 'true' : 'false')
        if (i === 0) li.classList.add('is-active')

        const crumb = hit.p ? `${hit.p}` : hit.c
        li.innerHTML = `
          <a href="${hit.u}">
            <span class="lg-search-hit-title">${highlight(hit.t, trimmed)}</span>
            <span class="lg-search-hit-crumb">${highlight(crumb, trimmed)}</span>
            <span class="lg-search-hit-snippet">${highlight(hit.snippet, trimmed)}</span>
          </a>
        `
        li.addEventListener('mousemove', () => {
          if (active !== i) setActive(i)
        })
        list.append(li)
      }

      if (hits.length > 0) input.setAttribute('aria-activedescendant', 'lg-search-hit-0')
    }

    const open = async () => {
      if (isOpen()) return
      root.hidden = false
      document.documentElement.classList.add('lg-search-open')
      input.value = ''
      lastQuery = ''
      list.innerHTML = ''
      meta.textContent = docs ? '输入关键词,↑↓ 选择,回车打开' : '正在载入索引…'
      input.focus()
      await loadIndex()
      if (isOpen()) {
        meta.textContent = '输入关键词,↑↓ 选择,回车打开'
        if (input.value.trim()) render(input.value)
      }
    }

    const close = () => {
      if (!isOpen()) return
      root.hidden = true
      document.documentElement.classList.remove('lg-search-open')
      trigger?.focus()
    }

    const openActive = () => {
      const current = list.querySelector<HTMLElement>('.lg-search-hit.is-active a')
      if (current instanceof HTMLAnchorElement) window.location.href = current.href
    }

    let timer: number | undefined
    input.addEventListener('input', () => {
      lastQuery = input.value
      window.clearTimeout(timer)
      timer = window.setTimeout(() => render(lastQuery), 90)
    })

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault()
        setActive(active + 1)
      } else if (event.key === 'ArrowUp') {
        event.preventDefault()
        setActive(active - 1)
      } else if (event.key === 'Enter') {
        event.preventDefault()
        openActive()
      }
    })

    trigger?.addEventListener('click', () => void open())
    root.querySelector('[data-search-close]')?.addEventListener('click', close)

    document.addEventListener('keydown', (event) => {
      const commandK = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k'
      if (commandK) {
        event.preventDefault()
        if (isOpen()) close()
        else void open()
        return
      }

      if (event.key === 'Escape' && isOpen()) {
        event.stopPropagation()
        close()
        return
      }

      // 不在输入框里时,按 / 也能开搜索
      const target = event.target
      const typing =
        target instanceof HTMLElement &&
        (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)
      if (event.key === '/' && !typing && !isOpen()) {
        event.preventDefault()
        void open()
      }
    })

    // 支持 ?q=线程池 这样的深链:打开就带着关键词搜(也方便分享一次搜索)
    const initial = new URLSearchParams(window.location.search).get('q')
    if (initial) {
      void open().then(() => {
        input.value = initial
        render(initial)
      })
    }
  }
</script>
