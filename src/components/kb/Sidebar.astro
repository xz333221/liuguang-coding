---
import { catalog } from '../../data/catalog'
import { levels } from '../../data/game'
import { terms } from '../../data/glossary'
import { categoryPath, countByCategory, countFor, getTopics, glossaryPath, withBase } from '../../lib/content'

interface Props {
  /** 当前分类 id,用于高亮 */
  current?: string
  /** 当前知识点 id,列在分类下面 */
  currentTopic?: string
  /** 不在分类树里的独立页面(目前只有 glossary) */
  page?: string
}

const { current, currentTopic, page } = Astro.props
const topics = await getTopics()
const counts = countByCategory(topics)
const roots = catalog.filter((item) => item.status !== 'hidden')

function topicsIn(id: string) {
  return topics.filter((topic) => topic.data.category === id)
}
---

<nav aria-label="分类导航" class="grid gap-0.5">
  {
    roots.map((root) => (
      <>
        <a href={categoryPath(root.id)} class="lg-nav-item" data-active={current === root.id}>
          <span>{root.name}</span>
          {root.status === 'soon' ? <span class="lg-badge">筹备中</span> : null}
          <span class="lg-nav-count">{countFor(root.id, counts)}</span>
        </a>

        {topicsIn(root.id).length > 0 && (
          <ul class="grid gap-0.5">
            {topicsIn(root.id).map((topic) => (
              <li>
                <a
                  href={categoryPath(root.id) + `${topic.id}/`}
                  class="lg-nav-item lg-nav-item--topic"
                  data-active={currentTopic === topic.id}
                >
                  <span class="min-w-0 flex-1 truncate">{topic.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {(root.children ?? [])
          .filter((child) => child.status !== 'hidden')
          .map((child) => (
            <>
              <a
                href={categoryPath(child.id)}
                class="lg-nav-item lg-nav-item--child"
                data-active={current === child.id}
              >
                <span>{child.name}</span>
                {child.status === 'soon' ? <span class="lg-badge">筹备中</span> : null}
                <span class="lg-nav-count">{countFor(child.id, counts)}</span>
              </a>

              {topicsIn(child.id).length > 0 && (
                <ul class="grid gap-0.5">
                  {topicsIn(child.id).map((topic) => (
                    <li>
                      <a
                        href={categoryPath(child.id) + `${topic.id}/`}
                        class="lg-nav-item lg-nav-item--topic"
                        data-active={currentTopic === topic.id}
                      >
                        <span class="min-w-0 flex-1 truncate">{topic.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </>
          ))}
      </>
    ))
  }

  <!-- 术语表不属于任何分类,单独挂在导航末尾 -->
  <a
    href={glossaryPath()}
    class="lg-nav-item mt-3 border-t border-line pt-3"
    data-active={page === 'glossary'}
  >
    <span>术语表</span>
    <span class="lg-nav-count">{terms.length}</span>
  </a>

  <!-- 闯关游戏同样不属于分类树,跟在术语表后面 -->
  <a
    href={withBase('game/')}
    class="lg-nav-item mt-1"
    data-active={page === 'game'}
  >
    <span>闯关游戏</span>
    <span class="lg-nav-count">{levels.length}</span>
  </a>
</nav>
