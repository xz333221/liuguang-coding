---
interface Props {
  href: string
  title: string
  summary: string
  level: string
  updated: string
}

const { href, title, summary, level, updated } = Astro.props
---

<a class="lg-topic-row group" href={href}>
  <div class="flex items-baseline gap-3">
    <h3 class="text-[0.98rem] font-medium transition-colors group-hover:text-highlight">{title}</h3>
    <span class="lg-meta ml-auto shrink-0">{level}</span>
  </div>
  <p class="mt-1.5 text-[0.85rem] leading-relaxed text-muted">{summary}</p>
  <p class="lg-meta mt-2">{updated} 更新</p>
</a>
