---
// 文章正文前面那一节「先弄清这几个词」。
// 目的很具体:正文里第一次出现的名词,读者在此之前就已经见过一句人话解释了。
import { resolveTerms, terms as allTerms } from '../../data/glossary'
import { glossaryPath } from '../../lib/content'
import TermCard from './TermCard.astro'

interface Props {
  /** frontmatter 里的 terms,顺序就是这里的展示顺序 */
  ids: string[]
}

const { ids } = Astro.props
const terms = resolveTerms(ids)
---

{
  terms.length > 0 ? (
    <section id="terms" class="mt-10 scroll-mt-24">
      <p class="lg-part">先弄清这几个词</p>
      <p class="lg-term-intro">
        这篇绕不开下面这些名词。每个都先给一句人话、再给一句准确的定义 ——
        看完这一段，正文里就不会出现"上来就说它是什么"的情况。
        正文里这些词第一次出现时会带下划线，悬停能看到同一句人话。
      </p>
      <div class="lg-term-grid">
        {terms.map((term) => (
          <TermCard term={term} variant="panel" />
        ))}
      </div>
      <p class="mt-5 text-[0.82rem] text-muted">
        这里只列了本篇要用的。术语表里一共 {allTerms.length} 个名词，按主题分好了组 ——
        <a href={glossaryPath()} class="text-highlight underline underline-offset-4 hover:no-underline">
          去术语表
        </a>
      </p>
    </section>
  ) : null
}
