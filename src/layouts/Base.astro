---
import '../styles/global.css'
import { AuthDialog } from '../components/AuthDialog'

interface Props {
  title: string
  description?: string
  /** og:type,文章页传 'article',其余页面默认 'website' */
  ogType?: string
  /** 社交封面图,默认全站统一的品牌封面(1200×630) */
  ogImage?: string
  /** JSON-LD 结构化数据(序列化好的字符串),文章页等按需传入 */
  jsonLd?: string
}

const { title, description, ogType = 'website', ogImage, jsonLd } = Astro.props
const base = import.meta.env.BASE_URL
// canonical / og:url:站点域名 + 当前路径拼绝对地址;取 pathname 天然去掉 query 与 hash
const canonical = new URL(Astro.url.pathname, Astro.site).href
const cover = new URL(ogImage ?? `${base}og-cover.png`, Astro.site).href
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="baidu-site-verification" content="codeva-s7d0K7sXZQ" />
    <meta name="theme-color" content="#0b0a09" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    {description ? <meta property="og:description" content={description} /> : null}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={cover} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="流光 coding 知识库" />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={cover} />
    {jsonLd ? <script type="application/ld+json" set:html={jsonLd} /> : null}
    <script is:inline>
      // 首屏前定主题,避免深色页面闪白。默认深色(品牌基调),读过手动切换后按读者的选择来。
      ;(function () {
        try {
          var saved = localStorage.getItem('lg-theme')
          document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark'
        } catch (error) {
          document.documentElement.dataset.theme = 'dark'
        }
      })()
    </script>
  </head>
  <body class="min-h-[100dvh] bg-canvas text-ink">
    <div aria-hidden="true" class="lg-grain pointer-events-none fixed inset-0 z-50"></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-5 focus:z-60 focus:rounded-full focus:bg-accent focus:px-5 focus:py-2.5 focus:text-sm focus:text-on-accent"
    >
      跳到主要内容
    </a>
    <slot />

    {/* 登录弹窗全站一份:页头、游戏里的"去登录"都派发 lg-auth:open 打开它 */}
    <AuthDialog client:only="react" />
  </body>
</html>
