---
import { AuthButton } from '../components/AuthButton'
import { ChatPanel } from '../components/chat/ChatPanel.tsx'
import ModelConfigDialog from '../components/chat/ModelConfigDialog.vue'
import { Mark } from '../components/ui/Mark'
import Sidebar from '../components/kb/Sidebar.astro'
import SearchPalette from '../components/kb/SearchPalette.astro'
import ThemeToggle from '../components/kb/ThemeToggle.astro'
import Base from './Base.astro'
import type { ArticleContext } from '../lib/chat'
import { withBase } from '../lib/content'

interface Props {
  title: string
  description?: string
  /** 当前分类 id,给侧栏高亮用 */
  category?: string
  /** 当前知识点 id */
  topic?: string
  /** 不在分类树里的独立页面(目前只有 glossary),同样给侧栏高亮用 */
  page?: string
  /** 当前文章:问答面板会把它作为上下文一起发出去 */
  article?: ArticleContext | null
  /** og:type,文章页传 'article',其余默认 'website' */
  ogType?: string
  /** JSON-LD 结构化数据(序列化好的字符串),文章页传入 */
  jsonLd?: string
}

const { title, description, category, topic, page, article = null, ogType, jsonLd } = Astro.props
const year = new Date().getFullYear()
---

<Base title={title} description={description} ogType={ogType} jsonLd={jsonLd}>
  <header class="lg-header">
    <div class="lg-header-inner">
      <a href={withBase()} class="lg-brand">
        <Mark className="h-7 w-7" />
        <span>流光 coding</span>
        <span class="lg-brand-tag">知识库</span>
      </a>

      <div class="ml-auto flex items-center gap-4">
        <SearchPalette />
        <a href={withBase('game/')} class="lg-header-link hidden sm:inline">闯关</a>
        <a href={withBase('glossary/')} class="lg-header-link hidden sm:inline">术语</a>
        <button type="button" class="lg-header-link" data-chat-open>问答</button>
        <a href={withBase('about/')} class="lg-header-link hidden sm:inline">关于</a>
        <a
          href="https://blog.flowdash.cn/"
          target="_blank"
          rel="noreferrer noopener"
          class="lg-header-link lg-header-ext hidden sm:inline-flex"
        >
          博客
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
        <ThemeToggle />
        <AuthButton client:only="react" />
      </div>
    </div>
  </header>

  <div class="kb-shell mx-auto flex max-w-[1240px] gap-10 px-5 md:px-8">
    <aside id="kb-side-left" class="hidden md:block">
      <div
        class="lg-scroll-slim sticky top-16 max-h-[calc(100dvh-4rem)] overflow-x-hidden overflow-y-auto py-8"
        data-kb-nav-scroll
      >
        <div class="kb-side-head">
          <p class="text-[0.72rem] tracking-[0.08em] text-muted">知识分类</p>
          <button
            type="button"
            class="kb-pane-btn"
            data-pane-toggle="left"
            aria-controls="kb-side-left"
            aria-expanded="true"
            aria-label="收起知识分类"
            title="收起知识分类"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6l-6 6 6 6" /></svg>
          </button>
        </div>
        <Sidebar current={category} currentTopic={topic} page={page} scope="d" />
      </div>
    </aside>

    <main id="main" class="min-w-0 flex-1 py-8 lg:py-10">
      <details class="mb-8 rounded-[18px] border border-line bg-surface lg:hidden">
        <summary class="cursor-pointer px-4 py-3 text-sm text-muted">分类导航</summary>
        <div class="overflow-x-hidden border-t border-line px-2 py-2">
          <Sidebar current={category} currentTopic={topic} page={page} scope="m" />
        </div>
      </details>

      <slot />
    </main>
  </div>

  <footer class="mt-16 border-t border-line">
    <div
      class="mx-auto flex max-w-[1240px] flex-col gap-2 px-5 py-6 text-xs text-muted md:flex-row md:items-center md:gap-6 md:px-8"
    >
      <p>© {year} 流光 coding · 编程知识库</p>
      <p>
        导图由 <a href="https://github.com/xz333221/flow-mindmap" class="hover:text-highlight">flow-mindmap</a> 渲染
      </p>
    </div>
  </footer>

  <div class="kb-pane-mask" data-pane-mask hidden></div>

  <button
    type="button"
    class="kb-pane-rail kb-pane-rail--left"
    data-pane-toggle="left"
    aria-controls="kb-side-left"
    aria-expanded="false"
    aria-label="展开知识分类"
    title="展开知识分类"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6l6 6-6 6" /></svg>
  </button>

  <ChatPanel client:only="react" article={article} />
  <ModelConfigDialog client:only="vue" />

  <script>
    // 页头与文章里的按钮只负责派发事件,面板自己决定怎么开
    for (const trigger of document.querySelectorAll('[data-chat-open]')) {
      trigger.addEventListener('click', () => {
        document.dispatchEvent(new CustomEvent('lg-chat:open'))
      })
    }
  </script>

  <script>
    // 左右两栏的展开/收起：桌面折叠改宽度，窄屏右侧变成抽屉
    const PANE_KEY = 'flowlight-kb-panes-v1'
    const PANE_DEFAULTS = {
      mobile: { left: 'closed', right: 'closed' },
      tablet: { left: 'open', right: 'closed' },
      desktop: { left: 'open', right: 'open' },
    }
    const paneBucket = () =>
      innerWidth < 768 ? 'mobile' : innerWidth < 1024 ? 'tablet' : 'desktop'
    const paneAttr = (pane: string) => (pane === 'left' ? 'kbLeft' : 'kbRight')
    const paneIsOpen = (pane: string) =>
      document.documentElement.dataset[paneAttr(pane)] === 'open'
    const readPanes = () => {
      try {
        const raw = localStorage.getItem(PANE_KEY)
        return raw ? JSON.parse(raw) : {}
      } catch {
        return {}
      }
    }

    function syncPanes() {
      for (const btn of document.querySelectorAll<HTMLElement>('[data-pane-toggle]')) {
        const pane = btn.dataset.paneToggle || ''
        const open = paneIsOpen(pane)
        btn.setAttribute('aria-expanded', String(open))
        btn.classList.toggle('is-pane-on', open)
      }
      const mask = document.querySelector<HTMLElement>('[data-pane-mask]')
      if (mask) mask.hidden = !(innerWidth < 1024 && paneIsOpen('right'))
    }

    function setPane(pane: string, open: boolean) {
      const bucket = paneBucket()
      const all = readPanes()
      all[bucket] = { ...(all[bucket] || PANE_DEFAULTS[bucket]), [pane]: open ? 'open' : 'closed' }
      try {
        localStorage.setItem(PANE_KEY, JSON.stringify(all))
      } catch {
        /* 隐私模式下只影响记忆，不影响本次切换 */
      }
      document.documentElement.dataset[paneAttr(pane)] = open ? 'open' : 'closed'
      syncPanes()
    }

    for (const btn of document.querySelectorAll<HTMLElement>('[data-pane-toggle]')) {
      btn.addEventListener('click', () => {
        const pane = btn.dataset.paneToggle || ''
        setPane(pane, !paneIsOpen(pane))
      })
    }
    document.querySelector('[data-pane-mask]')?.addEventListener('click', () => setPane('right', false))

    let lastPaneBucket = paneBucket()
    addEventListener('resize', () => {
      const bucket = paneBucket()
      if (bucket === lastPaneBucket) return
      lastPaneBucket = bucket
      const state = readPanes()[bucket] || PANE_DEFAULTS[bucket]
      document.documentElement.dataset.kbLeft = state.left
      document.documentElement.dataset.kbRight = state.right
      syncPanes()
    })
    syncPanes()
  </script>
</Base>
