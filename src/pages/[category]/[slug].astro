---
import Breadcrumbs from '../../components/kb/Breadcrumbs.astro'
import MindMapPanel from '../../components/kb/MindMapPanel.vue'
import SourceList from '../../components/kb/SourceList.astro'
import Toc from '../../components/kb/Toc.astro'
import { findCategory } from '../../data/catalog'
import type { ArticleContext } from '../../lib/chat'
import { formatDate, getTopics, neighboursOf, render, topicPath, withBase } from '../../lib/content'
import DocsLayout from '../../layouts/DocsLayout.astro'
import type { AstroComponentFactory } from 'astro/runtime/server/index.js'

export async function getStaticPaths() {
  const topics = await getTopics()
  return topics.map((topic) => ({
    params: { category: topic.data.category, slug: topic.id },
    props: { topic },
  }))
}

const { topic } = Astro.props
const meta = findCategory(topic.data.category)
const { Content, headings } = await render(topic)

const topics = await getTopics()
const { prev, next } = neighboursOf(topic, topics)

// 讲解组件按 frontmatter 的 demo 字段动态取,新增一个讲解只要丢一个文件进 src/demos/
const demoModules = import.meta.glob<{ default: AstroComponentFactory }>('../../demos/*.astro')
const Demo = topic.data.demo
  ? (await demoModules[`../../demos/${topic.data.demo}.astro`]())?.default
  : undefined
const mindmapSrc = topic.data.mindmap ? withBase(`mindmaps/${topic.data.mindmap}`) : null

// 问答面板要的上下文:标题、摘要、正文原文
const article: ArticleContext = {
  id: topic.id,
  title: topic.data.title,
  summary: topic.data.summary,
  categoryName: meta?.name ?? topic.data.category,
  body: topic.body ?? '',
}
---

<DocsLayout
  title={`${topic.data.title} · ${meta?.name ?? ''} · 流光 coding 知识库`}
  description={topic.data.summary}
  category={topic.data.category}
  topic={topic.id}
  article={article}
>
  <Breadcrumbs
    categoryId={topic.data.category}
    categoryName={meta?.name ?? topic.data.category}
    title={topic.data.title}
  />

  <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_190px] lg:gap-12">
    <article class="min-w-0">
      <h1 class="text-[1.9rem] leading-[1.25] font-medium tracking-tight md:text-[2.15rem]">
        {topic.data.title}
      </h1>
      <p class="mt-4 max-w-[34em] text-[0.98rem] leading-relaxed text-muted">{topic.data.summary}</p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <p class="lg-meta">
          {meta?.name} · {topic.data.level} · {formatDate(topic.data.updated)} 更新
        </p>
        <button type="button" class="lg-chip" data-chat-open>问这篇</button>
      </div>

      {
        mindmapSrc ? (
          <section id="map" class="mt-12 scroll-mt-24">
            <p class="lg-part">知识地图</p>
            <MindMapPanel client:only="vue" src={mindmapSrc} height={460} />
            <p class="mt-3 text-[0.78rem] text-muted">
              可以拖动、缩放画布，节点能折叠；这张图是用 flow-mindmap 画完导出的。
            </p>
          </section>
        ) : null
      }

      {
        Demo ? (
          <section id="demo" class="mt-14 scroll-mt-24">
            <p class="lg-part">动手看一遍</p>
            <Demo />
          </section>
        ) : null
      }

      <section id="read" class="mt-14 scroll-mt-24">
        <p class="lg-part">正文</p>
        <div class="lg-prose">
          <Content />
        </div>
      </section>

      <SourceList sources={topic.data.sources} />

      <nav aria-label="相邻知识点" class="mt-16 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
        {
          prev ? (
            <a href={topicPath(prev)} class="group text-sm">
              <span class="lg-meta">上一篇</span>
              <span class="mt-1 block transition-colors group-hover:text-highlight">
                ← {prev.data.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={topicPath(next)} class="group text-sm sm:text-right">
              <span class="lg-meta">下一篇</span>
              <span class="mt-1 block transition-colors group-hover:text-highlight">
                {next.data.title} →
              </span>
            </a>
          ) : null
        }
      </nav>
    </article>

    <aside class="hidden lg:block">
      <div class="sticky top-20 grid gap-10">
        <nav aria-label="本页结构" class="text-[0.82rem]">
          <p class="mb-3 text-[0.72rem] tracking-[0.08em] text-muted">本页结构</p>
          <ul class="grid gap-2">
            {mindmapSrc ? <li><a href="#map" class="text-muted transition-colors hover:text-ink">知识地图</a></li> : null}
            {Demo ? <li><a href="#demo" class="text-muted transition-colors hover:text-ink">动手看一遍</a></li> : null}
            <li><a href="#read" class="text-muted transition-colors hover:text-ink">正文</a></li>
            {topic.data.sources.length > 0 ? (
              <li><a href="#sources" class="text-muted transition-colors hover:text-ink">参考资料</a></li>
            ) : null}
          </ul>
        </nav>
        <Toc headings={headings} />
      </div>
    </aside>
  </div>
</DocsLayout>
