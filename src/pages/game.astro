---
import { GameApp } from '../components/game/GameApp.tsx'
import { decks, totalLevels, totalQuestions } from '../data/game'
import { withBase } from '../lib/content'
import DocsLayout from '../layouts/DocsLayout.astro'

const total = totalQuestions()
const levelTotal = totalLevels()
---

<DocsLayout
  title="闯关游戏 · 流光 coding 知识库"
  description="把知识点当关卡刷:一关一个主题,名词、场景、多选、排序、代码填空轮着来,答错的收进错题本。先刷 AI 应用开发这条线,为面试准备。"
  page="game"
>
  <nav aria-label="面包屑" class="mb-6 flex flex-wrap items-center gap-2 text-[0.78rem] text-muted">
    <a href={withBase()} class="hover:text-ink">知识库</a>
    <span aria-hidden="true" class="text-line-strong">/</span>
    <span class="text-ink">闯关游戏</span>
  </nav>

  <h1 class="text-[1.75rem] leading-[1.3] font-medium tracking-tight md:text-[2rem]">闯关游戏</h1>
  <p class="mt-4 max-w-[36em] text-[0.95rem] leading-relaxed text-muted">
    把知识点当关卡刷。一关一个主题,题型轮着来:名词、场景、代码阅读、判断、填空先选一项,多选和排序把答案攒齐,
    按「确定」或回车才判对错。
    答完一题给一段解析;答错的题自动收进错题本,刷完一轮再回来清。进度存在本机浏览器里,换设备不同步。
  </p>
  <p class="mt-3 max-w-[36em] text-[0.88rem] leading-relaxed text-muted">
    目前有 <span class="font-mono">{decks.length}</span> 个题库、共{' '}
    <span class="font-mono">{levelTotal}</span> 关 <span class="font-mono">{total}</span> 题。各题库走各自的解锁线,
    想先刷哪个都行。
  </p>

  <p class="mt-3 max-w-[36em] text-[0.88rem] leading-relaxed text-muted">
    题目口径按面试准备,解析里能指回站内讲解的地方都挂上了链接。选项顺序每次开场重新洗,靠位置蒙是不管用的。
  </p>

  <p class="mt-3 max-w-[36em] text-[0.82rem] leading-relaxed text-muted">
    键盘能加速:<span class="font-mono">1</span>–<span class="font-mono">6</span> 选选项,回车确定/下一题,选错了还能改。
  </p>

  <section class="mt-10">
    <GameApp client:only="react" />
  </section>
</DocsLayout>
