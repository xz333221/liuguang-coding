---
import CategoryCard from '../components/kb/CategoryCard.astro'
import TopicRow from '../components/kb/TopicRow.astro'
import { catalog } from '../data/catalog'
import { decks, totalLevels, totalQuestions } from '../data/game'
import { terms } from '../data/glossary'
import {
  categoryPath,
  countByCategory,
  countFor,
  formatDate,
  getTopics,
  glossaryPath,
  topicPath,
  withBase,
} from '../lib/content'
import DocsLayout from '../layouts/DocsLayout.astro'

const topics = await getTopics()
const counts = countByCategory(topics)
const roots = catalog.filter((item) => item.status !== 'hidden')
// 有内容的做卡片,筹备中的收成一行胶囊,免得网格末尾留空格子
const featured = roots.filter((item) => item.status === 'active')
const upcoming = roots.filter((item) => item.status === 'soon')
const recent = [...topics].sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime()).slice(0, 6)
---

<DocsLayout
  title="流光 coding 知识库"
  description="按主题整理的编程知识库:每个知识点都有知识地图、可动手的讲解和完整正文。先做 Python、Java、AI 与算法。"
>
  <section>
    <h1 class="text-[1.9rem] leading-[1.25] font-medium tracking-tight md:text-[2.2rem]">按主题整理的编程知识</h1>
    <p class="mt-4 max-w-[34em] text-[0.95rem] leading-relaxed text-muted">
      每个知识点都由三部分组成:一张知识地图、一段可以动手的讲解、以及完整的正文。
      先把 Python、Java、AI 与算法做扎实,其余方向陆续补上。
    </p>
  </section>

  <section class="mt-12">
    <h2 class="text-sm text-muted">现在有内容的</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        featured.map((root) => (
          <CategoryCard
            name={root.name}
            intro={root.intro}
            href={categoryPath(root.id)}
            status={root.status}
            count={countFor(root.id, counts)}
            note={root.note}
          />
        ))
      }
    </div>
  </section>

  <section class="mt-10">
    <a href={glossaryPath()} class="lg-card">
      <span class="lg-card-title">
        术语表
        <span class="lg-badge">{terms.length} 个名词</span>
      </span>
      <span class="lg-card-intro">
        看正文卡在某个词上时来这里查。每个名词都给两段:先一句人话讲清它大概是什么，再一句准确定义跟一手文档对齐。
        文章页开头也会把本篇要用的词单独列一遍，正文里这些词第一次出现时带下划线，悬停就能看到那句人话。
      </span>
    </a>
  </section>

  <section class="mt-10">
    <a href={withBase('game/')} class="lg-card">
      <span class="lg-card-title">
        闯关游戏
        <span class="lg-badge">
          {decks.length} 个题库 · {totalLevels()} 关 · {totalQuestions()} 题
        </span>
      </span>
      <span class="lg-card-intro">
        把知识点当关卡刷。一关一个主题，选择题推进，答完给一段解析;答错的题收进错题本，刷完一轮再回来清。
        目前有 AI 应用开发与 Python 两个题库，进度存在本机浏览器里。
      </span>
    </a>
  </section>

  <section class="mt-10">
    <h2 class="text-sm text-muted">筹备中的方向</h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        upcoming.map((root) => (
          <li>
            <a href={categoryPath(root.id)} class="lg-chip">
              {root.name}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-3 text-[0.82rem] text-muted">这些方向还没开始整理，点进去能看到打算怎么写。</p>
  </section>

  <section class="mt-14">
    <h2 class="text-sm text-muted">最近更新</h2>
    <div class="lg-divide mt-2">
      {
        recent.map((topic) => (
          <TopicRow
            href={topicPath(topic)}
            title={topic.data.title}
            summary={topic.data.summary}
            level={topic.data.level}
            updated={formatDate(topic.data.updated)}
          />
        ))
      }
    </div>
  </section>
</DocsLayout>
