<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 父工程负责版本号:spring-boot-starter-* 都不用写版本，
       依赖组合与插件配置跟 spring-boot-dependencies 走。 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.liuguang</groupId>
  <artifactId>springboot-demo</artifactId>
  <version>1.0.0</version>
  <name>springboot-demo</name>
  <description>流光知识库 · Spring Boot 项目结构示例</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!-- web:内嵌 Tomcat + Spring MVC + Jackson，一个依赖就能起 HTTP 服务 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</groupId>
    </dependency>

    <!-- data-jpa:把 Repository 接口自动变成可用的实现，底层用 Hibernate -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</groupId>
    </dependency>

    <!-- validation:让 @Valid / @NotBlank 这类注解真正生效 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</groupId>
    </dependency>

    <!-- H2:内存数据库，进程一停数据就没了，示例项目用它省掉装库的步骤 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 打可执行 jar:jar 里带内嵌 Tomcat，java -jar 就能跑 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
