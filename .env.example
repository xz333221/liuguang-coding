# 复制成仓库根的 .env 再填自己的值:.env 不进仓库,这个模板进。
# 不配也能起服务,只是登录、闯关云同步、按用户的模型配置不可用,
# /api/health 的 db 字段会显示 connecting。

# MySQL(库不存在时服务端会自动建)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=liuguang_coding

# 服务端端口与模型配置目录,不填用默认
# PORT=8787
# DATA_DIR=server/data

# 仓库里一条模型都没有时的兜底(平时在页面里配就行)
# UPSTREAM_BASE_URL=
# UPSTREAM_API_KEY=
# DEFAULT_MODEL=

# 只有跨域部署才需要,同源留空
# ALLOWED_ORIGIN=
